# Default (unset or mock): local face recast on Migos.mp4. No API key.
VIDEO_PROVIDER=mock

# Paid performer replacement. The source video never changes.
# One Fal Wan VACE pass per person at 480p, about $0.04 per video second.
# Migos.mp4 and the performer masks are uploaded once and reused.
# VIDEO_PROVIDER=fal
# FAL_KEY=

# External stub. This build does not call a video API.
# VIDEO_PROVIDER=external
# VIDEO_API_KEY=
# VIDEO_API_URL=
